# ============================================================
# Battery Analytics Portfolio - .gitignore
# ============================================================


# ------------------------------------------------------------
# Python byte-compiled / optimized files
# ------------------------------------------------------------
__pycache__/
*.py[codz]
*$py.class


# ------------------------------------------------------------
# C extensions
# ------------------------------------------------------------
*.so


# ------------------------------------------------------------
# Distribution / packaging
# ------------------------------------------------------------
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST


# ------------------------------------------------------------
# PyInstaller
# ------------------------------------------------------------
*.manifest
*.spec


# ------------------------------------------------------------
# Installer logs
# ------------------------------------------------------------
pip-log.txt
pip-delete-this-directory.txt


# ------------------------------------------------------------
# Unit test / coverage reports
# ------------------------------------------------------------
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache/
nosetests.xml
coverage.xml
*.cover
*.py.cover
.hypothesis/
.pytest_cache/
cover/


# ------------------------------------------------------------
# Type checking / linting
# ------------------------------------------------------------
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/


# ------------------------------------------------------------
# Environments
# ------------------------------------------------------------
.env
.envrc
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/


# ------------------------------------------------------------
# Jupyter / IPython
# ------------------------------------------------------------
.ipynb_checkpoints/
profile_default/
ipython_config.py

# Local notebook backups / temporary notebooks
*_backup.ipynb
Untitled.ipynb


# ------------------------------------------------------------
# IDE / editor files
# ------------------------------------------------------------
.spyderproject
.spyproject
.ropeproject
tempCodeRunnerFile.py

# Uncomment if IDE-specific settings should remain local
# .vscode/
# .idea/


# ------------------------------------------------------------
# Project build / documentation artifacts
# ------------------------------------------------------------
docs/_build/
site/
target/


# ------------------------------------------------------------
# Python package-management local state
# ------------------------------------------------------------
.pdm-python
.pdm-build/
.pixi/
__pypackages__/


# ------------------------------------------------------------
# Miscellaneous application state
# ------------------------------------------------------------
.scrapy/
.pybuilder/
.abstra/


# ------------------------------------------------------------
# Streamlit
# ------------------------------------------------------------
# Never commit Streamlit secrets or API credentials.
.streamlit/secrets.toml


# ============================================================
# DATA
# ============================================================

# NASA Li-ion battery raw datasets are intentionally excluded
# from version control.
#
# Keep B0005.mat, B0006.mat, B0007.mat, B0018.mat and any
# additional NASA .mat files locally under data/raw/.
#
# The repository should contain code and documentation required
# to reproduce the analysis, while users obtain the original
# dataset from the authoritative data source.
data/raw/*.mat


# ------------------------------------------------------------
# Optional generated/intermediate data
# ------------------------------------------------------------
# Uncomment these if the project later generates large
# intermediate datasets that should not be version controlled.
#
# data/interim/*
# data/processed/*


# ============================================================
# MODEL / EXPERIMENT ARTIFACTS
# ============================================================

# Do NOT ignore the final production model directory globally.
# Notebook 05 may intentionally version a small final model
# artifact required for inference.
#
# Ignore temporary model checkpoints instead.
models/checkpoints/
models/tmp/


# ------------------------------------------------------------
# Logs and temporary files
# ------------------------------------------------------------
*.log
*.tmp
*.temp
.DS_Store
Thumbs.db
# Local dashboard test exports
*_dashboard_test.csv
